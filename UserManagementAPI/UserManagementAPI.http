@UserManagementAPI_HostAddress = http://localhost:5012

### GET all users
GET {{UserManagementAPI_HostAddress}}/api/users
Accept: application/json

### GET an existing user by ID
GET {{UserManagementAPI_HostAddress}}/api/users/1
Accept: application/json

### GET a non-existent user (expected: 404)
GET {{UserManagementAPI_HostAddress}}/api/users/9999
Accept: application/json

### POST a new user (expected: 201)
POST {{UserManagementAPI_HostAddress}}/api/users
Content-Type: application/json

{
  "firstName": "Ada",
  "lastName": "Lovelace",
  "email": "ada@example.com",
  "department": "Engineering"
}

### POST with a missing first name (expected: 400)
POST {{UserManagementAPI_HostAddress}}/api/users
Content-Type: application/json

{
  "firstName": "",
  "lastName": "Lovelace",
  "email": "ada2@example.com",
  "department": "Engineering"
}

### POST with a whitespace-only first name (expected: 400)
POST {{UserManagementAPI_HostAddress}}/api/users
Content-Type: application/json

{
  "firstName": "   ",
  "lastName": "Lovelace",
  "email": "ada3@example.com",
  "department": "Engineering"
}

### POST with an invalid email address (expected: 400)
POST {{UserManagementAPI_HostAddress}}/api/users
Content-Type: application/json

{
  "firstName": "Grace",
  "lastName": "Hopper",
  "email": "not-an-email",
  "department": "Engineering"
}

### POST with a duplicate email address (expected: 409)
POST {{UserManagementAPI_HostAddress}}/api/users
Content-Type: application/json

{
  "firstName": "Charles",
  "lastName": "Babbage",
  "email": "ada@example.com",
  "department": "Operations"
}

### PUT the newly created user (expected: 204)
PUT {{UserManagementAPI_HostAddress}}/api/users/1
Content-Type: application/json

{
  "firstName": "Ada",
  "lastName": "Lovelace Updated",
  "email": "ada.updated@example.com",
  "department": "Engineering"
}

### PUT for a non-existent user (expected: 404)
PUT {{UserManagementAPI_HostAddress}}/api/users/9999
Content-Type: application/json

{
  "firstName": "No",
  "lastName": "User",
  "email": "ghost@example.com",
  "department": "HR"
}

### PUT with invalid data (expected: 400)
PUT {{UserManagementAPI_HostAddress}}/api/users/1
Content-Type: application/json

{
  "firstName": "",
  "lastName": "Updated",
  "email": "bad-email",
  "department": "Engineering"
}

### PUT attempting to use another user's email address (expected: 409)
PUT {{UserManagementAPI_HostAddress}}/api/users/1
Content-Type: application/json

{
  "firstName": "Ada",
  "lastName": "Lovelace",
  "email": "ada@example.com",
  "department": "Engineering"
}

### DELETE the newly created user (expected: 204)
DELETE {{UserManagementAPI_HostAddress}}/api/users/1

### DELETE for a non-existent user (expected: 404)
DELETE {{UserManagementAPI_HostAddress}}/api/users/9999

### GET the deleted user to confirm it returns 404 (expected: 404)
GET {{UserManagementAPI_HostAddress}}/api/users/1
Accept: application/json
