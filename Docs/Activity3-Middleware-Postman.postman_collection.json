{
  "info": {
    "_postman_id": "6f4e9b50-c2dd-4f07-83c8-04b0bf8eb07d",
    "name": "User Management API - Activity 3 Middleware Tests",
    "description": "Postman v2.1 collection for testing the Activity 3 middleware: configured bearer token authentication, request/response logging behavior, development-only error endpoint, and global exception handling. Run while UserManagementAPI is running in Development on http://localhost:5012.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5012"
    },
    {
      "key": "apiToken",
      "value": "fake-development-token-for-coursework-only"
    },
    {
      "key": "invalidToken",
      "value": "fake-invalid-token"
    }
  ],
  "item": [
    {
      "name": "01 - Swagger OpenAPI remains available without token - expected 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('returns OpenAPI JSON', function () {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('openapi');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/openapi/v1.json",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "openapi",
            "v1.json"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 - Valid token can access API - expected 200",
