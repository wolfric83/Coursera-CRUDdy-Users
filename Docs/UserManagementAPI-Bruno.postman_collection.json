{
  "info": {
    "_postman_id": "3f35f6e5-07b4-4b78-9861-f7cb5e45778d",
    "name": "User Management API - Activity 2 Debugging Tests",
    "description": "Import this Postman v2.1 collection into Bruno and run it while the UserManagementAPI project is running locally. The collection uses http://localhost:5012 by default and exercises the manual tests listed in Docs/Activity2-Debugging-Notes.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5012"
    },
    {
      "key": "runSuffix",
      "value": ""
    },
    {
      "key": "primaryUserId",
      "value": ""
    },
    {
      "key": "secondaryUserId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Create primary user - expected 201",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runSuffix', Date.now().toString());",
              "pm.collectionVariables.unset('primaryUserId');",
              "pm.collectionVariables.unset('secondaryUserId');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 201 Created', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('returns the created primary user', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('id');",
              "  pm.expect(body.firstName).to.eql('Ada');",
              "  pm.expect(body.lastName).to.eql('Lovelace');",
              "  pm.expect(body.email).to.eql(`ada.${pm.collectionVariables.get('runSuffix')}@example.com`);",
              "  pm.expect(body.department).to.eql('Engineering');",
              "  pm.collectionVariables.set('primaryUserId', body.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\",\n  \"email\": \"ada.{{runSuffix}}@example.com\",\n  \"department\": \"Engineering\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      },
      "response": []
    },
    {
