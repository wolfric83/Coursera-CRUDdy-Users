    {
      "name": "09 - Valid token calls development error endpoint - expected 500",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 500 Internal Server Error', function () {",
              "  pm.response.to.have.status(500);",
              "});",
              "",
              "pm.test('returns consistent safe error JSON', function () {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "  const body = pm.response.json();",
              "  pm.expect(body.error).to.eql('Internal server error.');",
              "  pm.expect(body.statusCode).to.eql(500);",
              "  pm.expect(body.traceId).to.be.a('string').and.not.empty;",
              "});",
              "",
              "pm.test('does not expose test exception details', function () {",
              "  const text = pm.response.text();",
              "  pm.expect(text).to.not.include('Test-only exception');",
              "  pm.expect(text).to.not.include('InvalidOperationException');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{apiToken}}"
          }
        ],
